---
/**
 * A forma verde do selo "inscrições abertas" — Figma 6032:2620.
 *
 * Um caminho só: barra larga embaixo e lóbulo alto à direita, unidos por
 * cantos côncavos. No Figma o nó está espelhado na horizontal (o código de
 * referência vem com `rotate(180) scaleY(-1)`, que é `scaleX(-1)`). O espelho
 * fica assado aqui dentro, no <g>, em vez de virar um transform em CSS: assim
 * o elemento continua livre para receber o transform do parallax.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
