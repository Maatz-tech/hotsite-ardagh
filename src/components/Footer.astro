---
/**
 * Rodapé — Figma 6028:1447 + 6028:1535 (desktop) e 6033:4598 + 6033:4683
 * (mobile). São duas faixas de azuis diferentes: a principal com as três
 * marcas, e a legal com a política de privacidade e o crédito.
 *
 * O rodapé usa grade de 1200 (margem de 120 no 1440), e não os 1216 do
 * resto da página — por isso a .footer-lp própria em vez de .container-lp.
 */
import Instagram from './icons/Instagram.astro';
import LinkedIn from './icons/LinkedIn.astro';
import Site from './icons/Site.astro';
import { SOCIAL_LINKS, LEGAL_LINKS } from '../data/site';
import { url } from '../lib/url';

const ICONS = { Instagram, LinkedIn, Site };
---

<footer class="on-dark">
  <!-- Faixa principal: Eureca · Ardagh Metal Packaging · redes -->
  <div class="bg-brand-band">
    <div
      class="footer-lp flex flex-col items-center gap-10 py-10 lg:flex-row lg:justify-between lg:py-20"
      data-reveal-stagger
    >
      <img
        src={url('/images/footer/eureca.webp')}
        alt="Eureca"
        width="336"
        height="62"
        class="h-6 w-[130px] lg:h-[30px] lg:w-[164px]"
        loading="lazy"
      />

      <img
        src={url('/images/footer/amp-branco.svg')}
        alt="Ardagh Metal Packaging"
        width="356"
        height="64"
        class="h-auto w-[356px] max-w-full"
        loading="lazy"
      />

      <ul class="flex items-center gap-2">
        {
          SOCIAL_LINKS.map((social) => {
            const Icon = ICONS[social.icon];
            return (
              <li>
                <a
                  href={social.href}
                  aria-label={social.label}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-btn flex size-10 items-center justify-center rounded-full bg-surface text-ink"
                >
                  <Icon class="size-6" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <!-- Faixa legal -->
  <div class="bg-brand-deep">
    <div
      class="footer-lp flex flex-col items-center gap-5 py-6 lg:flex-row lg:justify-between lg:gap-4 lg:py-[25px]"
    >
      <ul class="flex items-center gap-4 text-sm leading-[1.2]">
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="legal-link underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Crédito da Maatz pelo web component oficial. Ele monta a UTM
           sozinho a partir de `customer-name`, então não há link a manter
           aqui. `brand` é o tema de fundo colorido: texto e logo em branco.

           O conteúdo aqui dentro é o resguardo: o componente substitui o
           innerHTML quando registra, então isto só aparece se o script de
           terceiro não carregar. Sem ele, o crédito simplesmente sumiria. -->
      <maatz-footer theme="brand" customer-name="Ardagh Metal Packaging">
        <a
          href="https://maatz.com.br"
          target="_blank"
          rel="noopener noreferrer"
          class="credito-reserva"
        >
          Desenvolvido por Maatz
        </a>
      </maatz-footer>
    </div>
  </div>
</footer>

<style>
  /* O rodapé tem margem de 120 no 1440 (conteúdo de 1200), diferente dos
     112 do resto da página. O max-width soma o padding pelo mesmo motivo
     que a .container-lp. */
  .footer-lp {
    width: 100%;
    max-width: calc(1200px + 48px);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .legal-link {
    color: var(--color-line);
    transition: color 200ms ease;
  }

  /* O custom element é inline por padrão, então a caixa dele herda a
     altura de linha do contexto e a faixa legal crescia 8px. Como flex com
     line-height 1, ela volta a medir o conteúdo. */
  maatz-footer {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  /* Só aparece se o web component não registrar. */
  .credito-reserva {
    font-size: 14px;
    line-height: 1.2;
    color: var(--color-surface);
    text-decoration: underline;
  }

  .social-btn {
    transition:
      transform 200ms ease,
      background-color 200ms ease,
      color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .legal-link:hover {
      color: var(--color-surface);
    }

    .social-btn:hover {
      transform: translateY(-2px);
      background: var(--color-accent);
      color: var(--color-surface);
    }
  }
</style>

<script>
  import { revealStagger } from '../lib/motion';

  revealStagger('footer [data-reveal-stagger]');

  /* O crédito da Maatz vem de um web component hospedado fora. Como um
     <script src> normal ele é descoberto pelo pre-scanner e disputa banda
     com o LCP: numa medição em 4G lento isso custou 8 pontos de
     performance e 0,8s de LCP. Como ele está abaixo da dobra e o resguardo
     já mostra o crédito, dá para esperar a ociosidade — mesmo raciocínio do
     `aposCarregar()` em src/lib/motion.ts. */
  const carregarCredito = () => {
    if (document.querySelector('script[data-credito-maatz]')) return;
    const s = document.createElement('script');
    s.type = 'module';
    s.src = 'https://rodape.maatz.com.br/v1.js';
    s.dataset.creditoMaatz = '';
    document.head.append(s);
  };

  const agendar = () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(carregarCredito, { timeout: 2000 })
      : setTimeout(carregarCredito, 300);

  if (document.readyState === 'complete') agendar();
  else addEventListener('load', agendar, { once: true });
</script>
